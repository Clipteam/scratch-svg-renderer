{
  "name": "clipcc-svg-renderer",
  "version": "2.5.47",
  "description": "SVG renderer for ClipCC",
  "main": "./dist/node/scratch-svg-renderer.js",
  "browser": "./dist/web/scratch-svg-renderer.js",
  "exports": {
    "webpack": "./src/index.js",
    "browser": "./dist/web/scratch-svg-renderer.js",
    "node": "./dist/node/scratch-svg-renderer.js",
    "default": "./src/index.js"
  },
  "scripts": {
    "build": "npm run clean && webpack",
    "clean": "rimraf ./dist",
    "prepare": "husky install",
    "start": "webpack-dev-server",
    "test": "npm run test:lint && npm run test:unit",
    "test:lint": "eslint . --ext .js",
    "test:unit": "tap ./test/*.js",
    "watch": "webpack --watch"
  },
  "author": "Clipteam",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/Clipteam/clipcc-svg-renderer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Clipteam/clipcc-svg-renderer.git"
  },
  "peerDependencies": {
    "clipcc-render-fonts": "^1.0.254"
  },
  "dependencies": {
    "base64-js": "^1.2.1",
    "base64-loader": "^1.0.0",
    "css-tree": "^1.1.3",
    "fastestsmallesttextencoderdecoder": "^1.0.22",
    "isomorphic-dompurify": "^2.4.0",
    "@turbowarp/nanolog": "^1.0.1",
    "transformation-matrix": "^1.15.0"
  },
  "devDependencies": {
    "@babel/core": "7.26.0",
    "@babel/eslint-parser": "7.25.9",
    "@babel/preset-env": "7.26.0",
    "babel-loader": "9.2.1",
    "copy-webpack-plugin": "4.6.0",
    "eslint": "8.57.1",
    "eslint-config-scratch": "9.0.9",
    "eslint-plugin-import": "2.31.0",
    "husky": "8.0.3",
    "jsdom": "13.2.0",
    "json": "9.0.6",
    "mkdirp": "2.1.6",
    "rimraf": "3.0.2",
    "clipcc-render-fonts": "1.0.254",
    "scratch-webpack-configuration": "1.6.0",
    "tap": "11.1.5",
    "webpack": "5.96.1",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "3.11.3",
    "xmldom": "0.6.0"
  },
  "browserslist": [
    "Chrome >= 63",
    "Edge >= 15",
    "Firefox >= 57",
    "Safari >= 11"
  ]
}
